DELIMITER $$

CREATE TRIGGER archiwum_wypraw_trigger
AFTER DELETE ON wyprawa
FOR EACH ROW
BEGIN
    -- Wstawianie do tabeli archiwum_wypraw po usunięciu z tabeli wyprawa
    INSERT INTO archiwum_wypraw (id_wyprawy, nazwa, data_rozpoczecia, data_zakonczenia, kierownik)
    SELECT OLD.id_wyprawy, OLD.nazwa, OLD.data_rozpoczecia, OLD.data_zakonczenia, kreatura.nazwa
    FROM kreatura
    WHERE kreatura.idKreatury = OLD.kierownik;  -- Dopasowanie do kierownika
END $$

