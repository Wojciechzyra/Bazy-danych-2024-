CREATE PROCEDURE pobierz_sektory (
    IN wyprawa_id INT
)
BEGIN
    SELECT 
        CONCAT(sektor.nazwa, ' ', etapy_wyprawy.kolejnosc) AS numer_sektora,
        sektor.nazwa AS nazwa_sektora
    FROM 
        etapy_wyprawy
    JOIN 
        sektor ON etapy_wyprawy.sektor = sektor.id_sektora
    WHERE 
        etapy_wyprawy.idWyprawy = wyprawa_id
    ORDER BY 
        etapy_wyprawy.kolejnosc;
END //

DELIMITER ;

