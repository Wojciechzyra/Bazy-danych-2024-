DELIMITER //

CREATE PROCEDURE eliksir_sily (
    OUT srednia_udzwigu DECIMAL(10,2),
    OUT suma_udzwigu DECIMAL(10,2),
    OUT max_udzwigu DECIMAL(10,2)
)
BEGIN
    -- Obliczenie średniej udźwigu
    SELECT AVG(udzwig) INTO srednia_udzwigu FROM kreatura;

    -- Obliczenie sumy udźwigu
    SELECT SUM(udzwig) INTO suma_udzwigu FROM kreatura;

    -- Obliczenie maksymalnego udźwigu
    SELECT MAX(udzwig) INTO max_udzwigu FROM kreatura;
END //

DELIMITER ;
