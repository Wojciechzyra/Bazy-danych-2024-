CREATE TRIGGER sprawdz_teściową_domek
AFTER INSERT ON wyprawa
FOR EACH ROW
BEGIN
    -- Sprawdzamy, czy teściowa bierze udział w tej wyprawie i czy sektor to "domek dziadka"
    IF EXISTS (
        SELECT 1
        FROM uczestnicy u
        JOIN kreatura k ON u.id_uczestnika = k.idKreatury
        JOIN etapy_wyprawy ew ON ew.idWyprawy = u.id_wyprawy
        JOIN sektor s ON ew.sektor = s.id_sektora
        WHERE u.id_wyprawy = NEW.id_wyprawy
          AND k.idKreatury = 1  -- zakładamy, że teściowa ma id 1
          AND s.nazwa = 'Domek dziadka'
    ) THEN
        -- Wstawiamy alarm do system_alarmowy
        INSERT INTO system_alarmowy (wiadomosc)
        VALUES ('Teściowa nadchodzi !!!');
    END IF;
END //

DELIMITER ;
